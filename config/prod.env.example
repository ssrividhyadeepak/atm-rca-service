# Settings for the prod profile. Copy to config/prod.env (gitignored), fill in, then:
#   set -a; source config/prod.env; set +a
#   java -jar build/libs/atm-rca-service.jar --spring.profiles.active=prod
# On Windows, set the same names as environment variables before starting.

# MongoDB connection string. Contains credentials: keep it out of files that are committed.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.com/?tls=true
MONGODB_DATABASE=atm_rca

# Splunk management URL (port 8089 by default), not the web UI address. Must be https.
SPLUNK_URL=https://splunk.example.com:8089
# Authentication token from Splunk (Settings > Tokens). Preferred, and the only option with single sign-on.
SPLUNK_TOKEN=
# Only if there is no token:
# SPLUNK_USERNAME=
# SPLUNK_PASSWORD=
SPLUNK_INDEX=main

# Optional
# RCA_PORT=8090
# RCA_BIND_ADDRESS=127.0.0.1
# RCA_MONITOR_ENABLED=true
# RCA_MONITOR_CRON=0 */15 * * * *
