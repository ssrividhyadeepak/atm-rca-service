# Settings for the prod profile. Copy to config/prod.env (gitignored), fill in, then:
#   set -a; source config/prod.env; set +a
#   java -jar build/libs/bank-rca-service.jar --spring.profiles.active=prod
# On Windows, set the same names as environment variables before starting.

# MongoDB connection string. Contains credentials: keep it out of files that are committed.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.com/?tls=true
MONGODB_DATABASE=bank_rca

# Splunk management URL (port 8089 by default), not the web UI address. Must be https.
SPLUNK_URL=https://splunk.example.com:8089
# Sign in with your Splunk username and password. Do not write the password in this file:
# after loading this file, type it into the shell so it is neither saved nor echoed:
#   read -s SPLUNK_PASSWORD && export SPLUNK_PASSWORD
SPLUNK_USERNAME=
# Or, if your Splunk allows authentication tokens (Settings > Tokens), use one instead:
# SPLUNK_TOKEN=
SPLUNK_INDEX=main

# --- Application code (git) ---------------------------------------------------
# One repository: the remote to mirror (https). For several repositories, leave this empty
# and list them under rca.source.repositories in config/application-prod.yml.
GIT_REMOTE_URL=https://git.example.com/bank/app.git
# Read-only access token for the remote(s), and the username your git host expects with it
# (x-access-token works for GitHub; Bitbucket and GitLab want your username or 'oauth2').
# Do not write the token in this file; type it into the shell:
#   read -s GIT_TOKEN && export GIT_TOKEN
GIT_USERNAME=x-access-token
# Branch, tag or commit that production runs
RCA_DEPLOYED_REF=main
# Or, to read a clone that something else keeps up to date, instead of GIT_REMOTE_URL:
# RCA_REPO_DIR=/path/to/existing/clone

# --- Who may call this service -------------------------------------------------
# The identity provider that issues the bearer tokens. Tokens must carry
# aud=bank-rca-service and the scopes the client needs: rca:read, rca:write, logs:read,
# kb:read, code:read. The prod profile refuses to start without this.
RCA_ISSUER_URI=https://login.example.com/realms/bank
# Public URL of this service, advertised to clients
# RCA_RESOURCE_URL=https://bank-rca.example.com

# --- Incidents ----------------------------------------------------------------
# Approved incidents are only recorded (mock) unless this is set to servicenow. Set it on
# purpose: from then on, every approval creates a real ticket.
# RCA_INCIDENT_MODE=servicenow
# SERVICENOW_URL=https://yourbank.service-now.com
# SERVICENOW_USERNAME=
# Type the password into the shell:  read -s SERVICENOW_PASSWORD && export SERVICENOW_PASSWORD
# Or an OAuth token instead of username and password:
# SERVICENOW_TOKEN=

# Optional
# RCA_PORT=8090
# RCA_BIND_ADDRESS=127.0.0.1
# RCA_MONITOR_ENABLED=true
# RCA_MONITOR_CRON=0 */15 * * * *

# Change requests: stub (sample file) until set to servicenow. Read-only; uses the
# SERVICENOW_* connection settings, and does not turn incident submission on.
# RCA_CHANGE_MODE=servicenow
